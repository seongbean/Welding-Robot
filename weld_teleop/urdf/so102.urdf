<?xml version="1.0" encoding="utf-8"?>
<!--
  SO-102 임시 URDF (기구학 전용, 실측 기반)
  ==========================================
  기반: SO-ARM100/Simulation/SO101/so101_new_calib.urdf (onshape-to-robot 생성).
  변경: wrist_flex와 wrist_roll 사이에 wrist_yaw 관절 삽입 (SO-102 손목 3축:
  wrist_flex[pitch] -> wrist_yaw[yaw] -> wrist_roll[포인팅축]).
  wrist_flex 이전 체인과 gripper 이후 체인은 SO-101 값을 그대로 유지한다
  (lerobot new calibration 영점 관례 보존).

  실측값 (2026-07-30, 자 측정 - 길이는 축 방향 성분, 대각선 아님):
    - wrist_flex 축 -> wrist_yaw 축: 길이 방향 0.056 m
      + 횡방향 오프셋 0.0181 m (flex 축 방향)
    - wrist_yaw 축 -> wrist_roll 축: 길이 방향 0.056 m
      + 횡방향 오프셋 0.0181 m (yaw 축 방향으로 적용 - 가정 2 참조)
    - 회전축은 서로 직각
      (wrist_flex=상하, wrist_yaw=좌우, wrist_roll=포인팅축 회전)

  임시 가정 (CAD 확정 시 갱신할 것):
    1. 두 오프셋의 부호는 임시 - flex->yaw는 SO-101 flex->roll과 같은
       쪽(+z_wrist_link)으로 가정(zero pose TCP가 SO-101과 0.4mm 이내
       일치해 방증). yaw->roll은 -z_wrist_yaw_link로 확정(2026-10-06 실측:
       영점 자세에서 wrist_roll 축이 wrist_flex 축보다 +10 mm 높음,
       예측 +z 가정 -18 mm / -z 가정 +18 mm)
    2. 오프셋 방향은 "직전 관절 회전축 방향"으로 가정 (서보 혼 장착
       체인 패턴 - SO-101 flex->roll 오프셋과 동일 구조)
    3. SO-101 roll 축의 스큐(0.0487 rad)는 직각 설계 가정으로 제거
    4. wrist_yaw 축 부호는 임시 - 실기에서 회전 방향 확인 필요
    5. wrist_yaw 리밋 +-1.5708 rad(+-90도)는 임시값 (기구 간섭각 미측정)
    6. 손목 구간 질량/관성은 SO-101 값 유지 + placeholder (기구학 IK 무영향)
  메시(visual/collision)는 생략 - 기구학(IK) 전용. 원본 메시 경로가 이
  디렉터리에 없기도 하고, SO-102 손목 부품 형상도 다르다.
-->
<robot name="so102">

  <!-- ============================================================ -->
  <!-- 링크 (관성값: SO-101 유래, 손목 구간은 placeholder)          -->
  <!-- ============================================================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>
  </link>

  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>
  </link>

  <!-- 손목 1구간 (wrist_flex ~ wrist_yaw). 관성은 SO-101 wrist_link 유래
       placeholder - TODO: CAD 확정 시 SO-102 실제값으로 교체 -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="0 -0.028 0" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="0" ixz="0" iyy="2.5391e-05" iyz="0" izz="2.1e-05"/>
    </inertial>
  </link>

  <!-- 손목 2구간 (wrist_yaw ~ wrist_roll). 신규 링크 - 관성 placeholder
       (STS3215 서보 1개 무게 근사). TODO: CAD 확정 시 교체 -->
  <link name="wrist_yaw_link">
    <inertial>
      <origin xyz="0 -0.028 0" rpy="0 0 0"/>
      <mass value="0.065"/>
      <inertia ixx="2.5e-05" ixy="0" ixz="0" iyy="2.0e-05" iyz="0" izz="2.0e-05"/>
    </inertial>
  </link>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>
    </inertial>
  </link>

  <!-- TCP(그리퍼 끝단) 더미 링크 - 텔레옵 IK의 태스크 프레임 -->
  <link name="gripper_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!-- 관절: base ~ wrist_flex (SO-101 값 그대로)                   -->
  <!-- ============================================================ -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 관절: SO-102 신규/수정 손목 구간                             -->
  <!-- ============================================================ -->
  <!-- [신규] wrist_yaw: wrist_flex 축에서 링크 방향(-y)으로 0.056m
       + 횡방향(+z = flex 축 방향) 오프셋 0.0181m (실측).
       회전축(z)은 wrist_link의 +x = flex 축과 링크 방향 모두에 수직
       (rpy="0 1.5708 0"이 z_child를 x_parent로 정렬). 축 부호 임시 -->
  <joint name="wrist_yaw" type="revolute">
    <origin xyz="0 -0.056 0.0181" rpy="0 1.5708 0"/>
    <parent link="wrist_link"/>
    <child link="wrist_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.5708" upper="1.5708"/>
  </joint>

  <!-- [수정] wrist_roll: 부모가 wrist_yaw_link로 변경. wrist_yaw 축에서
       링크 방향(-y)으로 0.056m + yaw 축 방향(+z = 이 프레임의 관절축)
       반대(-z) 오프셋 0.0181m (실측, 부호 2026-10-06 확인). rpy="0 1.5708 1.5708"은
       Ry(-90) * Rz(180) * Rx(90) 합성 결과로, wrist_yaw=0일 때
       gripper_link 방향이 SO-101과 일치하도록(스큐 제거만 차이) 맞춘 값.
       리밋은 SO-101 값 유지 - TODO: SO-102 실기 확인 -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="0 -0.056 -0.0181" rpy="0 1.5708 1.5708"/>
    <parent link="wrist_yaw_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <!-- ============================================================ -->
  <!-- 관절: gripper 이후 (SO-101 값 그대로)                        -->
  <!-- ============================================================ -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>

  <!-- TCP: 고정 조 끝단 프레임 (텔레옵 컨트롤러 pose가 대응될 지점) -->
  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
    <axis xyz="0 0 0"/>
  </joint>

</robot>
